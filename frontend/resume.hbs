<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <meta name="robots" content="noindex" />
    <meta name="description" content="A simple resume site" />
    <meta name="author" content="{{basics.name}}" />
    <title>{{basics.name}}</title>
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <!-- Font Awesome icons (free version)-->
    <script
      src="https://use.fontawesome.com/releases/v6.1.0/js/all.js"
      crossorigin="anonymous"
    ></script>
    <!-- Google fonts-->
    <link
      href="https://fonts.googleapis.com/css?family=Saira+Extra+Condensed:500,700"
      rel="stylesheet"
      type="text/css"
    />
    <link
      href="https://fonts.googleapis.com/css?family=Muli:400,400i,800,800i"
      rel="stylesheet"
      type="text/css"
    />
    <!-- Core theme CSS (includes Bootstrap)-->
    <link href="styles.css" rel="stylesheet" />
    <!-- Additional CSS -->
    <link href="additional.css" rel="stylesheet" />
  </head>
  <body id="page-top">
    <!-- Navigation-->
    <nav
      class="navbar navbar-expand-lg navbar-dark bg-primary fixed-top html-only"
      id="sideNav"
    >
      <a class="navbar-brand js-scroll-trigger" href="#page-top">
        <span class="d-block d-lg-none">{{basics.name}}</span>
      </a>
      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarResponsive"
        aria-controls="navbarResponsive"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarResponsive">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link js-scroll-trigger" href="#about">About</a>
          </li>
          <li class="nav-item">
            <a class="nav-link js-scroll-trigger" href="#experience"
              >Experience</a
            >
          </li>
          <li class="nav-item">
            <a class="nav-link js-scroll-trigger" href="#education"
              >Education</a
            >
          </li>
          <li class="nav-item">
            <a class="nav-link js-scroll-trigger" href="#skills">Skills</a>
          </li>
          <li class="nav-item">
            <a class="nav-link js-scroll-trigger" href="#awards"
              >Certifications</a
            >
          </li>
        </ul>
      </div>
    </nav>
    <!-- Page Content-->
    <div class="container-fluid p-0">
      <!-- About-->
      <section class="resume-section" id="about">
        <div class="resume-section-content">
          <h1 class="mb-0 html-only">
            {{firstName}}
            <span class="text-primary">{{lastName}}</span>
          </h1>
          <h3 class="mb-0 html-only">{{basics.label}}</h3>
          <div class="subheading mb-5 html-only">
            <a href="mailto:{{basics.email}}">{{basics.email}}</a> ·
            {{#each basics.profiles}}<a href="{{url}}">{{username}}</a>{{#unless @last}} · {{/unless}}{{/each}}
          </div>
          <div class="pdf-only">
            <h1 style="font-size: 72px; padding-bottom: 0">{{firstName}} {{lastName}}</h1>
            <h2 style="font-size: 44px !important; padding-bottom: 0">
              DevOps Engineer / SRE
            </h2>
            <br />
            <div style="font-size: 20px">
              <a href="mailto:{{basics.email}}">EMAIL: {{basics.email}}<br /></a>
              {{#each basics.profiles}}
              <a href="{{url}}">{{network}}: {{username}}<br /></a>
              {{/each}}
            </div>
          </div>
          <div class="pdf-only">
            <br />
            <p style="font-size: 20px">
              I'm a DevOps / SRE professional with 5 years of experience. <br />
              A big fan of IaC, troubleshooting and the SRE methodology.
            </p>
          </div>
          <div class="html-only">
            {{{summaryHtml}}}
          </div>
          <br />
          <!-- Align text to right as signature -->
          <div class="social-icons">
            <a class="social-icon" href="https://linkedin.com/in/sergei-chukh"
              ><i class="fab fa-linkedin-in"></i
            ></a>
            <a class="social-icon" href="https://github.com/spigell"
              ><i class="fab fa-github"></i
            ></a>
          </div>
        </div>
      </section>

      <hr class="m-0" />
      <!-- Experience-->
      <section class="resume-section" id="experience">
        <div class="resume-section-content">
          <h2 class="mb-0">Experience</h2>
          <br />
          {{#each workArray}}
          <div class="d-flex flex-column flex-md-row justify-content-between mb-5">
            <div class="flex-grow-1">
              {{#if website}}
              <a class="mb-0" href="{{website}}">{{#if logoClass}}<img class="{{logoClass}}" />{{/if}}</a>
              {{/if}}
              <h4 class="mb-0">{{name}}</h4>
              <h2 class="mb-0">{{position}}</h2>
              <h6 class="mb-0">{{formatDateRange startDate endDate}}</h6>
              {{#if summary}}
              <p>{{summary}}</p>
              {{/if}}
              {{#if highlights}}
          <ul>
            {{#each skills}}
            <li>{{name}}: {{join keywords ", "}}</li>
            {{/each}}
          </ul>
              {{/if}}
            </div>
          </div>
          {{/each}}
        </div>
      </section>
      <hr class="m-0" />
      <!-- Education-->
      <section class="resume-section" id="education">
        <div class="resume-section-content">
          <h2 class="mb-5">Education</h2>
          <div class="d-flex flex-column flex-md-row justify-content-between mb-5">
            <div class="flex-grow-1">
              <h3 class="mb-0">{{education.institution}}</h3>
              <h5 class="mb-0">{{education.startDate}} - {{education.endDate}}</h5>
              <div class="subheading mb-3">{{education.studyType}}</div>
              <div>{{education.area}}</div>
            </div>
          </div>
        </div>
        </section>
      <hr class="m-0" />
      <!-- Skills-->
      <section class="resume-section" id="skills">
        <div class="resume-section-content">
          <h2 class="mb-5">Skills</h2>
          <ul>
            {{#each skills}}
            <li>{{name}}: {{join keywords ", "}}</li>
            {{/each}}
          </ul>
        </div>
      </section>
      <div class="pdf-only">
        <!-- Ugly hack -->
        <br />
        <br />
        <br />
        <br />
      </div>
      <hr class="m-0" />
      <!-- Awards-->
      <section class="resume-section" id="awards">
        <div class="resume-section-content">
          <h2 class="mb-5">Certifications</h2>
          <ul>
            {{#each certificatesArray}}
            <li><a href="{{url}}">{{name}}</a> - {{issuer}}</li>
            {{/each}}
          </ul>
        </div>
      </section>
    </div>
    <!-- Bootstrap core JS-->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Core theme JS-->
    <script src="scripts.js"></script>
  </body>
</html>
